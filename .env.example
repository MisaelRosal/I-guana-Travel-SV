# Local / Docker environment template.
# Copy to `.env` (gitignored) and replace the placeholder values below.
# Only non-secret defaults belong here; real credentials stay out of tracked files.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here
POSTGRES_DB=iguana_sv

# --- MinIO ---
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=your-minio-password-here

# --- API local port (single source of truth, design TD1) ---
# launchSettings applicationUrl, Vite /api proxy target and the docker-compose
# host mapping all resolve to this value.
API_PORT=5000

# --- JWT signing (design TD4) ---
# Secret used to sign the auth cookie. MUST be a long random value and MUST NOT
# be committed. Locally, provide it via user-secrets instead of this file:
#   dotnet user-secrets set "Jwt:Key" "<32+ char random secret>" --project Backend/IguanaSV.Api
# In docker/CI, set the Jwt__Key environment variable. The value stays empty here.
Jwt__Key=
# Optional overrides (defaults shown). Only set if you change the token contract.
# Jwt__Issuer=iguana-sv-api
# Jwt__Audience=iguana-sv-spa
# Jwt__ExpiresInMinutes=60

# --- CORS allowlist (spec: credentials-aware allowlist, design TD4) ---
# Comma- or semicolon-separated production/preview origins with scheme+port,
# e.g. https://iguana.example.com. The local dev origins (localhost:5173,
# localhost, localhost:5000) are always allowlisted by the API and need no entry.
CORS__ALLOWED_ORIGINS=

# --- Correo saliente (transporte: Gmail API / OAuth 2.0) ---
# Remitente RFC 5322. Debe ser una dirección autorizada por el proveedor de
# correo configurado (el transporte es Gmail API; ver abajo).
EMAIL_FROM=IguanaSV <no-reply@iguanatravelapp.de5.net>
# false = el registro se completa sin verificar el correo (útil si el correo
# está mal configurado y no querés bloquear el alta de cuentas).
EMAIL_VERIFICACION_HABILITADA=true

# --- Gmail API (OAuth 2.0) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client.
# El refresh token se obtiene UNA sola vez abriendo /api/auth/gmail-connect,
# autorizando la cuenta y copiando el token que muestra /oauth2callback.
GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=...
GOOGLE_OAUTH_REFRESH_TOKEN=
# URI de redirección registrada en Google (debe coincidir EXACTAMENTE).
# Local: http://localhost:5000/oauth2callback — Producción: https://<dominio>/oauth2callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/oauth2callback
